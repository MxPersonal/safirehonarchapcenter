# Configure at Vercel > Project Settings > Environment Variables, or local .env.local.
# All NEXT_PUBLIC_* values are visible to site visitors. Never place secrets in them.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase public URL + publishable/anon key with RLS policies installed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not yet used; future optional server-side integrations only:
# PAYMENT_PROVIDER_SECRET_KEY=
# STORAGE_PRIVATE_KEY=
# DATABASE_URL=

# Server-only admin account gate. NEVER prefix these with NEXT_PUBLIC_.
# ADMIN_EMAIL must equal a confirmed Supabase Auth user with profiles.role='admin'.
# The account's Supabase password must match the password used to make the hash.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
