# All settings below are optional for the storefront demo.
# Configure in Vercel > Project > Settings > Environment Variables.
# Values prefixed NEXT_PUBLIC_ are visible to every site visitor. NEVER use them for secrets.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# For future server-only backend integration; NOT used by demo.
# DATABASE_URL=
# PAYMENT_PROVIDER_SECRET_KEY=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
